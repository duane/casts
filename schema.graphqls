type Link {
  href: String!
  rel: String
  mediaType: String
  hrefLang: String
  title: String
  length: Int
}

type Entry {
  title: String!
  guid: String!
  summary: String!
  links: [Link!]!
  content: Content
}

type Content {
  body: String
  contentType: String!
  length: Int
  src: Link
}

type Mutation {
  addFeed(streamId: Uuid!, feedId: Uuid!, url: Url!): Uuid!
}

type Feed {
  "The ID of the feed."
  feedId: Uuid!
  "The title of the feed."
  title: String!
  "Authors of the feed"
  authors: [String!]!
  "A string describing the feed."
  description: String!
  "A list of entries to which the feed links."
  entries: [Entry!]!
  "A link to an image with which to represent the feed."
  logo: Image
}

type Subscription {
  watchFeeds(streamId: Uuid!): [Feed!]!
}

type Query {
  feeds(streamId: Uuid!): [Feed!]!
}

scalar Url

scalar Uuid

type Image {
  url: Url
  rawUrl: String!
  title: String
  link: Link
  width: Int
  height: Int
  description: String
}

schema {
  query: Query
  mutation: Mutation
  subscription: Subscription
}

