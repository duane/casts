type MediaContent {
  url: Url
  contentType: String
  height: Int
  width: Int
  size: Int
}

type Link {
  href: Url!
  rel: String
  mediaType: String
  hrefLang: String
  title: String
  length: Int
}

type Entry {
  title: String!
  guid: String!
  summary: String!
  links: [Link!]!
  content: Content
  media: [MediaObject!]!
  """
    Last recorded playback position in whole seconds; absent when the
    entry has never been listened to.
  """
  elapsedSeconds: Int
}

type MediaObject {
  "Title of the object (from the media:title element)"
  title: String
  "Collection of the media content elements"
  content: [MediaContent!]!
  "Duration of the object in seconds"
  durationS: Int
  "Duration of the object in milliseconds"
  durationMs: Int
  "Short description of the media object (from the media:description element)"
  description: String
}

type Content {
  body: String
  contentType: String!
  length: Int
  src: Link
}

type Mutation {
  addFeed(streamId: Uuid!, feedId: Uuid!, url: Url!): Uuid!
}

type Feed {
  "The ID of the feed."
  feedId: Uuid!
  "The title of the feed."
  title: String!
  "Authors of the feed"
  authors: [String!]!
  "A string describing the feed."
  description: String!
  "A list of entries to which the feed links."
  entries: [Entry!]!
  "A link to an image with which to represent the feed."
  logo: Image
}

type Subscription {
  watchFeeds(streamId: Uuid!): [Feed!]!
}

scalar Url

type Query {
  feeds(streamId: Uuid!): [Feed!]!
}

scalar Uuid

type Image {
  url: Url
  rawUrl: String!
  title: String
  link: Link
  width: Int
  height: Int
  description: String
}

schema {
  query: Query
  mutation: Mutation
  subscription: Subscription
}

