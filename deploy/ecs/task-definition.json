{
  "family": "casts",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "512",
  "memory": "1024",
  "runtimePlatform": {
    "cpuArchitecture": "ARM64",
    "operatingSystemFamily": "LINUX"
  },
  "executionRoleArn": "arn:aws:iam::690591551001:role/casts-task-execution",
  "taskRoleArn": "arn:aws:iam::690591551001:role/casts-task",
  "containerDefinitions": [
    {
      "name": "casts-grpc-server",
      "image": "690591551001.dkr.ecr.us-east-1.amazonaws.com/casts:5274913",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8243,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "RUST_LOG",
          "value": "info"
        },
        {
          "name": "CASTS_LISTEN",
          "value": "::"
        },
        {
          "name": "CASTS_PORT",
          "value": "8243"
        },
        {
          "name": "COMMIT_STORE_ADDR",
          "value": "https://commit-store.internal:7392"
        }
      ],
      "secrets": [
        {
          "name": "CASTS_TLS_CERT_PEM",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:690591551001:secret:casts/tls-cert-31lQq0"
        },
        {
          "name": "CASTS_TLS_KEY_PEM",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:690591551001:secret:casts/tls-key-NIarHk"
        },
        {
          "name": "CASTS_CLIENT_CA_PEM",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:690591551001:secret:commit-store/client-ca-kkTxZ0"
        },
        {
          "name": "COMMIT_STORE_CA_PEM",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:690591551001:secret:commit-store/client-ca-kkTxZ0"
        },
        {
          "name": "COMMIT_STORE_CLIENT_CERT_PEM",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:690591551001:secret:casts/commit-store-client-cert-zoHQto"
        },
        {
          "name": "COMMIT_STORE_CLIENT_KEY_PEM",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:690591551001:secret:casts/commit-store-client-key-sIIBU2"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/casts",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "casts"
        }
      },
      "stopTimeout": 10,
      "healthCheck": {
        "command": [
          "CMD",
          "/usr/local/bin/casts-health-probe"
        ],
        "interval": 15,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 15
      }
    }
  ]
}
