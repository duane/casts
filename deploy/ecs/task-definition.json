{
  "family": "casts",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "512",
  "memory": "1024",
  "runtimePlatform": {
    "cpuArchitecture": "ARM64",
    "operatingSystemFamily": "LINUX"
  },
  "executionRoleArn": "arn:aws:iam::690591551001:role/casts-task-execution",
  "taskRoleArn": "arn:aws:iam::690591551001:role/casts-task",
  "containerDefinitions": [
    {
      "name": "casts-grpc-server",
      "image": "690591551001.dkr.ecr.us-east-1.amazonaws.com/casts:REPLACE_WITH_TAG",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8243,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "RUST_LOG",
          "value": "info"
        },
        {
          "name": "CASTS_LISTEN",
          "value": "::"
        },
        {
          "name": "CASTS_PORT",
          "value": "8243"
        },
        {
          "name": "COMMIT_STORE_SERVER",
          "value": "https://commit-store.internal:7392"
        }
      ],
      "secrets": [
        {
          "name": "COMMIT_STORE_CA_PEM",
          "valueFrom": "REPLACE_WITH_SECRET_ARN/ca"
        },
        {
          "name": "COMMIT_STORE_CLIENT_CERT_PEM",
          "valueFrom": "REPLACE_WITH_SECRET_ARN/casts/commit-store-client-cert"
        },
        {
          "name": "COMMIT_STORE_CLIENT_KEY_PEM",
          "valueFrom": "REPLACE_WITH_SECRET_ARN/casts/commit-store-client-key"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/casts",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "casts"
        }
      },
      "stopTimeout": 10
    }
  ]
}
